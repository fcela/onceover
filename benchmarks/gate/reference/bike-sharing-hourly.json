{
 "dataset": "bike-sharing-hourly",
 "note": "Provisional statements written from reading the table; the maintainer replaces them.",
 "statements": [
  {"id": "cnt-identity", "tier": "must", "provisional": true,
   "text": "cnt = casual + registered",
   "kind": "identity", "columns": ["cnt", "casual", "registered"],
   "patterns": ["\\bcnt\\b", "casual", "registered"],
   "check": "(pl.col('cnt') == pl.col('casual') + pl.col('registered')).all()"},
  {"id": "cnt-hour", "tier": "must", "provisional": true,
   "text": "cnt depends on the hour of the day (hr)",
   "kind": "relates", "columns": ["cnt", "hr"],
   "patterns": ["\\bcnt\\b", "\\bhr\\b"],
   "check": "pl.col('cnt').mean().over('hr').max() > 3 * pl.col('cnt').mean().over('hr').min()"},
  {"id": "temp-atemp", "tier": "should", "provisional": true,
   "text": "temp and atemp are nearly collinear",
   "kind": "relates", "columns": ["temp", "atemp"],
   "patterns": ["\\btemp\\b", "\\batemp\\b"],
   "check": "pl.corr('temp', 'atemp') > 0.9"},
  {"id": "cnt-temperature", "tier": "should", "provisional": true,
   "text": "cnt rises with temperature",
   "kind": "relates", "columns": ["cnt"], "columns_any": ["temp", "atemp"],
   "patterns": ["\\bcnt\\b", "\\ba?temp\\b"],
   "check": "pl.corr('cnt', 'temp') > 0.3"},
  {"id": "instant-index", "tier": "should", "provisional": true,
   "text": "instant is a row number and dteday the time axis",
   "kind": "role", "columns": ["instant"],
   "patterns": ["instant|dteday", "row|index|time axis|identifier|key|distinct"],
   "check": "(pl.col('instant') == pl.int_range(1, pl.len() + 1)).all()"},
  {"id": "cnt-year", "tier": "should", "provisional": true,
   "text": "cnt grows from 2011 to 2012 (yr)",
   "kind": "relates", "columns": ["cnt"], "columns_any": ["yr", "dteday", "instant"],
   "patterns": ["\\bcnt\\b", "\\byr\\b|dteday|instant|trend"],
   "check": "pl.col('cnt').filter(pl.col('yr') == 1).mean() > pl.col('cnt').filter(pl.col('yr') == 0).mean()"},
  {"id": "cnt-rush-hour-concentration", "tier": "should", "provisional": true,
   "text": "rentals concentrate in rush hours on working days: 35.9% of all rentals sit on 17.2% of rows (2.09x their row share)",
   "kind": "concentration", "columns": ["cnt", "workingday", "hr"],
   "patterns": ["\\bcnt\\b", "workingday|working day", "rush|hour|concentrat"],
   "note": "Measured: the cell workingday = 1 and hr in (7, 8, 9, 17, 18, 19) holds 2,983 of 17,379 rows (17.2%) and 1,181,285 of 3,292,679 rentals (35.9%), 2.09x its row share. The concentration is measure-weighted: it lives in the cnt values over the cell, not in the cell's row count (row counts over the (workingday, hr) grid track independence almost exactly). No current pass aggregates a measure over categorical cells outside panel structure (issue #329), so no finding states this yet; the miss is the measurement.",
   "check": "(((pl.col('cnt').filter(((pl.col('workingday') == 1) & (pl.col('hr').is_in([7, 8, 9, 17, 18, 19])))).sum() / pl.col('cnt').sum()) > 0.30) & ((pl.col('cnt').filter(((pl.col('workingday') == 1) & (pl.col('hr').is_in([7, 8, 9, 17, 18, 19])))).sum() / pl.col('cnt').sum()) > 1.8 * ((pl.col('workingday') == 1) & (pl.col('hr').is_in([7, 8, 9, 17, 18, 19]))).mean()))"}
 ]
}
