{
 "dataset": "adult-census-income",
 "note": "Provisional statements written from reading the table; the maintainer replaces them.",
 "statements": [
  {"id": "education-encoding", "tier": "must", "provisional": true,
   "text": "education and education_num are two encodings of the same variable",
   "kind": "encoding", "columns": ["education", "education_num"],
   "patterns": ["\\beducation\\b", "education_num"],
   "check": "pl.struct(['education', 'education_num']).n_unique() == pl.col('education').n_unique()"},
  {"id": "income-marital", "tier": "must", "provisional": true,
   "text": "income depends on marital_status or relationship",
   "kind": "relates", "columns": ["income"], "columns_any": ["marital_status", "relationship"],
   "patterns": ["\\bincome\\b", "marital_status|relationship"],
   "check": "(pl.col('income') == '>50K').mean().over('marital_status').max() > 1.5 * (pl.col('income') == '>50K').mean()"},
  {"id": "income-education", "tier": "must", "provisional": true,
   "text": "income depends on education",
   "kind": "relates", "columns": ["income"], "columns_any": ["education", "education_num"],
   "patterns": ["\\bincome\\b", "\\beducation(_num)?\\b"],
   "check": "(pl.col('income') == '>50K').mean().over('education_num').max() > 2 * (pl.col('income') == '>50K').mean()"},
  {"id": "income-capital-gain", "tier": "must", "provisional": true,
   "text": "income depends on capital_gain",
   "kind": "relates", "columns": ["income", "capital_gain"],
   "patterns": ["\\bincome\\b", "capital_gain"],
   "check": "(pl.col('income') == '>50K').filter(pl.col('capital_gain') > 0).mean() > 2 * (pl.col('income') == '>50K').mean()"},
  {"id": "income-age-hours", "tier": "should", "provisional": true,
   "text": "income depends on age or hours_per_week",
   "kind": "relates", "columns": ["income"], "columns_any": ["age", "hours_per_week"],
   "patterns": ["\\bincome\\b", "\\bage\\b|hours_per_week"],
   "check": "(pl.col('income') == '>50K').filter(pl.col('hours_per_week') >= 50).mean() > (pl.col('income') == '>50K').mean()"},
  {"id": "capital-gain-99999", "tier": "should", "provisional": true,
   "text": "capital_gain holds a pile of 99999, a code and not an amount",
   "kind": "sentinel", "columns": ["capital_gain"],
   "patterns": ["capital_gain", "99,?999"],
   "check": "(pl.col('capital_gain') == 99999).sum() > 100"},
  {"id": "occupation-workclass-missing", "tier": "should", "provisional": true,
   "text": "occupation and work_class are missing on the same rows",
   "kind": "missingness", "columns": ["occupation", "work_class"],
   "patterns": ["occupation", "work_class", "missing|null"],
   "check": "(pl.col('occupation').is_null() == pl.col('work_class').is_null()).mean() > 0.9"}
 ]
}
