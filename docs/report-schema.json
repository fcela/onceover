    "finding": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "missingness",
            "concentration",
            "column_roles",
            "uniqueness",
            "duplicates",
            "formats",
            "dependencies",
            "conditional_rules",
            "associations",
            "gaps",
            "intervals",
            "ordering",
            "changes"
          ],
          "type": "string"
        },
        "claim": {
          "type": "string"
        },
        "detector_interestingness": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1,
          "type": "array"
        },
        "facets": {
          "$ref": "#/$defs/facets"
        },
        "grouped_members": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ids of the statements grouped under this finding (it is a verified relationship family's lead); the named full records are in the report's grouped_findings."
        },
        "grouped_under": {
          "type": "string",
          "description": "The lead finding's id, when this statement was grouped under a verified relationship family; grouped statements live in grouped_findings, not findings."
        },
        "id": {
          "type": "string"
        },
        "interestingness": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "interpretation": {
          "type": "string"
        },
        "specification": {
          "$ref": "#/$defs/specification"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "type": {
          "description": "Subtype within the category; always present. Values by category: missingness: missing_values | sentinel_values; concentration: value_concentration | hotspot (plus modal_share | spike_cells from the views pass); column_roles: categorical_role | identifier_role | duplicate_encoding | long_format; uniqueness: uniqueness; duplicates: duplicate_rows | near_duplicate_rows; formats: format_variation | heaping | digit_preference | benford_deviation | boundary_mass | content_anomaly; dependencies: functional | predictive | order_constraint | order_violation; conditional_rules: if_then; associations: statistical | period_association | group_contrast; gaps: gap | sequence_gap | missing_combinations | unexamined_columns | unscanned_series | partial_period; intervals: interval_variation | extreme_value | categorical_outlier | row_inconsistency; ordering: column_ordering; changes: residual_level | level_shift | trend_change | variance_change | transient_excursion | step_discontinuity | distribution_shift | ordered_partition | series_structure | one_way_flag | entry_block | exit_block | first_activity.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "category",
        "facets",
        "type",
        "subject",
        "specification",
        "claim",
        "evidence",
        "interestingness"
      ],
      "type": "object"
    },
